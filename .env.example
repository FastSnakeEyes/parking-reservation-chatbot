# Template for .env.development / .env.production - copy it and fill in the values:
#   cp .env.example .env.development
# This file is committed: never put a real key or password in it.
# Read by the app (app/config.py) unless marked "docker compose" or "MCP server".

# ---------- App ----------
APP_ENV=development
TIMEZONE=Europe/Vilnius
# docker compose: where the API is published on the host
API_PORT=8000
BIND_ADDRESS=127.0.0.1

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Chat model, also used to summarize long conversations
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- PostgreSQL ----------
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Production alternative to the POSTGRES_* fields above - a full SQLAlchemy URL
# (async driver), e.g. postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_URL=
# docker compose
POSTGRES_IMAGE=postgres:18
POSTGRES_PUBLISHED_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
# docker compose
REDIS_IMAGE=redis:7-alpine
REDIS_PUBLISHED_PORT=6379

# ---------- Milvus (static docs search) ----------
VECTOR_DB_URI=http://milvus:19530
# Or a local Milvus Lite file instead of the server:
# VECTOR_DB_URI=/data/milvus_parking.db
# Only for a Milvus server with authentication enabled (e.g. Zilliz Cloud):
MILVUS_TOKEN=
MILVUS_COLLECTION=parking_static
# Chunks returned per search (see "Choosing K" in evals/report.md)
RETRIEVER_K=3
# hybrid (semantic + BM25 keywords, default) | semantic (embeddings only) | keyword (BM25 only)
SEARCH_TYPE=hybrid
# docker compose
MILVUS_IMAGE=milvusdb/milvus:v2.5.4
MILVUS_PUBLISHED_PORT=19530

# ---------- Chat session cookie ----------
COOKIE_NAME=parking_chat
COOKIE_TTL=1800
# Seconds between sweeps deleting chat threads idle longer than COOKIE_TTL
CHAT_CLEANUP_INTERVAL=600

# ---------- Limits ----------
MAX_ACTIVE_USERS=100
ACTIVE_USER_TTL=60
RATE_LIMIT_TIMES=2
RATE_LIMIT_SECONDS=10

# ---------- Conversation memory ----------
HISTORY_MAX_TOKENS=3000
HISTORY_KEEP_TOKENS=1500
# tiktoken (exact, for OpenAI models) | approximate
TOKEN_COUNTER=tiktoken

# ---------- Guardrails (sensitive data protection) ----------
# Public contacts the PII filter must never redact (JSON list). Must match the text in
# data/vilnius-parking-data/static/general_info.md.
PUBLIC_CONTACTS=["+370 5 200 0000", "info@vilpark.lt"]
# Optional ML prompt-injection classifier
USE_INJECTION_MODEL=false
INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# spaCy NER model used by Presidio for PII detection
SPACY_MODEL=en_core_web_sm

# ---------- Admin and MCP server ----------
# Your own random values, e.g. `openssl rand -hex 32` (production rejects short or default keys)
ADMIN_API_KEY=
MCP_API_KEY=
MCP_SERVER_URL=http://mcp-server:9000/mcp
# MCP server: where approved reservations are appended
RESERVATIONS_FILE=/data/approved_reservations.txt
# docker compose
MCP_SERVER_PUBLISHED_PORT=9000

# ---------- Logging and tracing ----------
# Also read by the MCP server
LOG_LEVEL=INFO
# LangSmith (off by default): set the key from https://smith.langchain.com and TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vilniuspark-chatbot
# EU-region LangSmith accounts only (an EU key gets 403 on the default US endpoint):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
