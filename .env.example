# --- docker compose (variable substitution in docker-compose.yaml) ---
BIND_ADDRESS=127.0.0.1
API_PORT=8000
POSTGRES_IMAGE=postgres:18
POSTGRES_PUBLISHED_PORT=5432
REDIS_IMAGE=redis:7-alpine
REDIS_PUBLISHED_PORT=6379
MILVUS_IMAGE=milvusdb/milvus:v2.5.4
MILVUS_PUBLISHED_PORT=19530
MCP_SERVER_PUBLISHED_PORT=9000

# --- app settings (app/config.py) ---
APP_ENV=development
TIMEZONE=Europe/Vilnius

POSTGRES_DB=fastapi_db
POSTGRES_USER=fastapi_user
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Production alternative to the POSTGRES_* fields above - a full SQLAlchemy URL
# (async driver), e.g. postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_URL=

REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=replace-with-your-openai-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

VECTOR_DB_URI=http://milvus:19530
# Only for a Milvus server with authentication enabled (e.g. Zilliz Cloud):
# MILVUS_TOKEN=
MILVUS_COLLECTION=parking_static
RETRIEVER_K=4

COOKIE_NAME=parking_chat
COOKIE_TTL=1800
# Seconds between sweeps deleting chat threads idle longer than COOKIE_TTL
CHAT_CLEANUP_INTERVAL=600
MAX_ACTIVE_USERS=100
ACTIVE_USER_TTL=60
RATE_LIMIT_TIMES=2
RATE_LIMIT_SECONDS=10

HISTORY_MAX_TOKENS=3000
HISTORY_KEEP_TOKENS=1500
TOKEN_COUNTER=tiktoken

USE_INJECTION_MODEL=false
INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
SPACY_MODEL=en_core_web_sm

# Contact strings that must survive PII redaction (chat answers, search
# queries, and static-doc ingestion) because they're the operator's own
# published contact info, not a customer's. Must match the exact text as
# it appears in your content - see data/vilnius-parking-data/static/general_info.md.
PUBLIC_CONTACTS=["+370 5 200 0000", "info@vilpark.lt"]

# Stage 2: admin API (app/api/routers/admin.py, ui/admin_app.py)
ADMIN_API_KEY=replace-with-a-local-dev-admin-key

# Stage 3: MCP server (mcp_server/server.py, app/ai/graph.py MCP client)
MCP_SERVER_URL=http://mcp-server:9000/mcp
MCP_API_KEY=replace-with-a-local-dev-mcp-key
RESERVATIONS_FILE=/data/approved_reservations.txt

# Stage 4: LangGraph checkpointer (app/ai/graph.py) uses the same Postgres
# database as everything else - see database_url_psycopg in app/config.py.

# Logging (app/logger.py). Also read directly by mcp_server/server.py.
LOG_LEVEL=INFO

# LangSmith tracing (app/lifespan.py). Off by default; set these three to
# enable - get an API key from https://smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=vilniuspark-chatbot
# EU-region LangSmith accounts only (US is the default; an EU key gets 403 there):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
